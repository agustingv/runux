{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Runux",
  "version": "0.1.24",
  "identifier": "es.agustingarcia.runux",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Runux",
        "width": 1280,
        "height": 780,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; object-src 'none'; base-uri 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "publisher": "Agustín García",
    "shortDescription": "Lanzador de juegos de Windows para Linux",
    "longDescription": "Runux instala y abre Battle.net y la EA app en prefijos de Wine o Proton, detecta sus juegos y los lanza. También instala juegos desde ISO o DVD y descarga GE-Proton sin necesidad de Steam.",
    "linux": {
      "deb": {
        "depends": [
          "udisks2",
          "python3",
          "libarchive-tools"
        ],
        "files": {
          "/etc/apt/sources.list.d/runux.sources": "packaging/runux.sources",
          "/usr/share/keyrings/runux.gpg": "packaging/runux.gpg"
        }
      },
      "rpm": {
        "depends": [
          "udisks2",
          "python3",
          "bsdtar"
        ],
        "files": {
          "/etc/yum.repos.d/runux.repo": "packaging/runux.repo",
          "/etc/pki/rpm-gpg/RPM-GPG-KEY-runux": "packaging/RPM-GPG-KEY-runux"
        }
      }
    }
  }
}
